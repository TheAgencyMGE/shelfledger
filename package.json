{
  "name": "shelfledger",
  "version": "0.1.0",
  "private": true,
  "description": "Free, open-source action figure release radar. Track new announcements, preorders, restocks and releases across manufacturers and retailers without an account.",
  "keywords": [
    "action-figures",
    "release-tracker",
    "preorders",
    "toy-collector",
    "collectibles",
    "marvel-legends",
    "black-series",
    "mcfarlane",
    "neca",
    "mafex",
    "shfiguarts",
    "mezco",
    "funko",
    "transformers",
    "gi-joe",
    "dc-multiverse",
    "open-source",
    "rss",
    "pwa",
    "static-site",
    "github-pages",
    "no-account"
  ],
  "homepage": "https://theagencymge.github.io/shelfledger/",
  "repository": {
    "type": "git",
    "url": "https://github.com/TheAgencyMGE/shelfledger.git"
  },
  "bugs": {
    "url": "https://github.com/TheAgencyMGE/shelfledger/issues"
  },
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "lint": "node scripts/lint.mjs",
    "test": "node --test test/*.test.mjs",
    "check": "npm run lint && npm test && npm run build",
    "icons": "python scripts/gen_icons.py",
    "scrape": "node scripts/scrape-releases.mjs",
    "serve": "node scripts/serve.mjs",
    "screenshots": "node scripts/screenshots.mjs"
  }
}
