{
  "name": "shelfledger",
  "version": "0.1.0",
  "private": true,
  "description": "Open-source release radar for action figures, Funko Pops, anime figures and collectibles. No account, no cloud, no tracking.",
  "keywords": [
    "release-tracker",
    "action-figures",
    "collectibles",
    "funko",
    "funko-pop",
    "mezco",
    "one12-collective",
    "shfiguarts",
    "tamashii-nations",
    "anime-figures",
    "statues",
    "preorders",
    "collection-tracker",
    "wishlist",
    "privacy-first",
    "local-first",
    "offline-first",
    "pwa",
    "static-site",
    "github-pages"
  ],
  "homepage": "https://theagencymge.github.io/shelfledger/",
  "repository": {
    "type": "git",
    "url": "https://github.com/TheAgencyMGE/shelfledger.git"
  },
  "bugs": {
    "url": "https://github.com/TheAgencyMGE/shelfledger/issues"
  },
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "lint": "node scripts/lint.mjs",
    "test": "node --test test/*.test.mjs",
    "check": "npm run lint && npm test && npm run build",
    "icons": "python scripts/gen_icons.py",
    "scrape": "node scripts/scrape-releases.mjs",
    "seed-catalog": "node scripts/seed-catalog.mjs",
    "serve": "node scripts/serve.mjs",
    "screenshots": "node scripts/screenshots.mjs"
  }
}
